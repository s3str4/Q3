{
  "name": "arena-duel",
  "version": "0.1.0",
  "description": "Quake 3-style 1v1 arena duel: browser client, headless Node authoritative server, shared deterministic simulation.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "duel": "node tools/bot_duel.mjs",
    "evidence": "node tools/evidence.mjs",
    "netbench": "node tools/netbench.mjs",
    "build:static": "node tools/build_static.mjs",
    "serve:static": "node tools/build_static.mjs --serve 8080"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "three": "0.169.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "puppeteer-core": "23.6.0"
  }
}
